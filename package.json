  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "qa": "npm run lint && npm run typecheck && npm run film-plates:build && npm run build && npm run film-plates:audit && npm run ships:audit && npm run hunter-kit:audit && node --test --test-concurrency=1 tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "film-plates:build": "node scripts/build-film-plate-prompt-pack.mjs",
    "film-plates:audit": "node scripts/audit-film-plates.mjs",
    "film-plates:normalize": "node scripts/normalize-film-plates.mjs",
    "film-plates:contact-sheets": "node scripts/build-film-plate-contact-sheets.mjs",
    "film-plates:references": "node scripts/fetch-film-plate-references.mjs",
    "ships:audit": "node scripts/audit-ship-assets.mjs",
    "hunter-kit:audit": "node scripts/audit-hunter-kit-assets.mjs",
    "galaxy-v11:build-backgrounds": "node scripts/build-galaxy-v11-system-backgrounds.mjs",
    "dlc:build-manifest": "node scripts/build-private-dlc-manifest.mjs",
    "dlc:split-wave-01": "py -3 scripts/split-private-dlc-atlas.py",
    "dlc:validate": "node scripts/validate-private-dlc.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
