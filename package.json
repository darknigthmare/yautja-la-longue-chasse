{
  "name": "yautja-la-longue-chasse",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "npm run biome-decor:v19:runtime-data",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/start-production.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
