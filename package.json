    "ships:audit": "node scripts/audit-ship-assets.mjs",
    "cutouts:build": "node scripts/build-cutout-manifests.mjs",
    "hunter-kit:audit": "node scripts/audit-hunter-kit-assets.mjs",
    "trophies:audit": "node scripts/audit-trophy-assets.mjs",
    "trophies:contact-sheets": "node scripts/build-trophy-contact-sheets.mjs",
    "franchise-trophies:build-specs": "node scripts/build-franchise-trophy-prompt-pack.mjs",
    "franchise-trophies:references": "node scripts/fetch-franchise-trophy-references.mjs",
    "franchise-trophies:audit": "node scripts/audit-franchise-trophy-assets.mjs",
    "enemy-trophies:build-specs": "node scripts/build-enemy-trophy-prompt-pack.mjs",
    "enemy-trophies:audit": "node scripts/audit-enemy-trophy-assets.mjs",
    "enemy-trophies:gameplay-build": "node scripts/build-enemy-trophy-gameplay-v18.mjs",
    "enemy-trophies:gameplay-audit": "node scripts/audit-enemy-trophy-gameplay-v18.mjs",
    "biome-decor:v19:runtime-data": "node scripts/build-biome-decor-v19-manifests.mjs --runtime-data-only",
    "biome-decor:v19:manifests": "node scripts/build-biome-decor-v19-manifests.mjs",
    "biome-decor:v19:audit": "node scripts/audit-biome-decor-v19.mjs",
    "galaxy-v11:build-backgrounds": "node scripts/build-galaxy-v11-system-backgrounds.mjs",
    "dlc:build-manifest": "node scripts/build-private-dlc-manifest.mjs",
    "dlc:split-wave-01": "py -3 scripts/split-private-dlc-atlas.py",
    "dlc:validate": "node scripts/validate-private-dlc.mjs",
    "db:generate": "drizzle-kit generate",
    "ship-interior:export": "node scripts/export-ship-interior-v21.mjs",
    "ship-interior:audit": "node scripts/audit-ship-interior-v21.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
