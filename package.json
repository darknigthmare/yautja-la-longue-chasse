    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "film-plates:build": "node scripts/build-film-plate-prompt-pack.mjs",
    "film-plates:audit": "node scripts/audit-film-plates.mjs",
    "film-plates:normalize": "node scripts/normalize-film-plates.mjs",
