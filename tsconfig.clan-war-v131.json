{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "plugins": []
  },
  "include": [
    "types/clan-war-v120-css.d.ts",
    "app/game/systems/clanWarViewV131.ts",
    "app/game/ClanWarGauntletV131.tsx",
    "app/game/HunterGauntletArtV132.tsx",
    "app/game/ClanWarGauntletLockerV132.tsx",
    "app/game/systems/clanWarGauntletCatalogV132.ts",
    "app/game/systems/useHunterGauntletV133.ts",
    "app/game/systems/gauntletCampaignV134.ts",
    "app/game/systems/gauntletRigSpritesV139.ts",
    "app/game/data/clanWarGauntletCatalogV132.json"
