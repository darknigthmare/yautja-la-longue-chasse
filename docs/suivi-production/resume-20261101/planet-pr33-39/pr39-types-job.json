{
  "patterns": [
    "/*",
    "!/*/",
    "/app/",
    "/desktop/",
    "/scripts/",
    "/tests/",
    "/db/",
    "/worker/",
    "/drizzle/",
    "/build/",
    "/.openai/hosting.json",
    "/public/**/manifest.json"
  ],
  "job": {
    "name": "Full application TypeScript (planet PR)",
    "runs-on": "ubuntu-latest",
    "timeout-minutes": 20,
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1",
      "ELECTRON_SKIP_BINARY_DOWNLOAD": "1",
      "NODE_OPTIONS": "--max-old-space-size=6144"
    },
    "steps": [
      {
        "name": "Checkout real application, configuration and manifests for full types",
        "uses": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
        "with": {
          "fetch-depth": 1,
          "sparse-checkout-cone-mode": false,
          "sparse-checkout": "/*\n!/*/\n/app/\n/desktop/\n/scripts/\n/tests/\n/db/\n/worker/\n/drizzle/\n/build/\n/.openai/hosting.json\n/public/**/manifest.json\n"
        }
      },
      {
        "name": "Node 22",
        "uses": "actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020",
        "with": {
          "node-version": "22",
          "cache": "npm"
        }
      },
      {
        "name": "Install exact locked dependencies without lifecycle scripts",
        "run": "npm ci --ignore-scripts --no-audit --no-fund"
      },
      {
        "name": "Generate Next route and environment types",
        "run": "node node_modules/next/dist/bin/next typegen"
      },
      {
        "name": "Check the complete application TypeScript",
        "run": "npm run typecheck"
      }
    ]
  },
  "needs": [
    "domain",
    "types"
  ]
}
