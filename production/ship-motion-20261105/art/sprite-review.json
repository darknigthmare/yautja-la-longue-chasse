  "findings": [
    {
      "id": "F01",
      "severity": "fixed-by-calibration",
      "finding": "All variant calibration values were staging estimates. The source silhouettes have different bow, engine and lower-shell positions; the measured table replaces those estimates."
    },
    {
      "id": "F02",
      "severity": "integration-requirement",
      "finding": "An inspected engine socket is not necessarily visible. The chamber is only visibly exposed in the two rear views; the other views and original profile require visibility 0."
    },
    {
      "id": "F03",
      "severity": "non-issue-after-compositing",
      "finding": "Unpremultiplied inspection displays brown/blue RGB data in transparent background pixels. Correct RGBA composites are clean and runtime exports preserve the source alpha."
    },
    {
      "id": "F04",
      "severity": "artistic-review-open",
      "finding": "The variants preserve fork, ribbed hull, dorsal spines, ventral blade and olive-bronze/orange material family. Small rib and internal engine details vary because these are generated projections, not renders of a shared 3D mesh. Exact canonical 1:1 is not established."
    },
    {
      "id": "F05",
      "severity": "browser-review-required",
      "finding": "The reviewed renderer uses plus-lighter in an isolated paint group to prevent overlap-opacity loss. Independent generated silhouettes still require browser inspection for double contours, and cloak-field continuity at transition midpoints. Static inspection does not establish transition quality."
    },
    {
      "id": "F06",
      "severity": "scope",
      "finding": "Eight alternate views cover the classic-predator-spaceship hull only. Other selected hulls retain their own profile and must never silently receive this hull."
    }
  ],
