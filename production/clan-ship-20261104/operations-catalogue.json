  "space": {
    "maxTurns": 16,
    "maxEnergy": 8,
    "initialEnergy": 5,
    "scenarios": [
      {
        "id": "interception",
        "title": "Interception du signal hostile",
        "briefing": "Un bâtiment armé suit les routes du clan. Identifie sa signature et intercepte-le avant qu’il ne transmette la position du convoi.",
        "objective": "Neutraliser le bâtiment ou couper ses moteurs puis envoyer une équipe d’abordage.",
        "assetLabel": "Route du clan"
      },
      {
        "id": "escort",
        "title": "Écran de retour",
        "briefing": "Des chasseurs regagnent le vaisseau après une expédition. Couvre leur passage pendant qu’un assaillant cherche à isoler le transport.",
        "objective": "Identifier le contact, rejoindre la couverture, protéger 3 segments de route puis extraire le transport.",
        "assetLabel": "Transport allié"
      },
      {
        "id": "recovery",
        "title": "Capsule dans les débris",
        "briefing": "Une capsule de l’expédition dérive entre les débris. Un bâtiment hostile verrouille la zone : ouvre un passage pour l’équipe de récupération.",
        "objective": "Analyser le contact, neutraliser sa propulsion ou l’affaiblir, aborder à courte portée puis extraire la capsule.",
        "assetLabel": "Capsule à récupérer"
      }
    ],
    "orders": [
      {
        "id": "scan",
        "label": "Analyser le contact",
        "detail": "Révèle la signature, puis prépare la solution d’abordage. Le contact réagit pendant l’analyse.",
        "cost": 1
      },
      {
        "id": "manoeuvre",
        "label": "Manœuvrer",
        "detail": "Resserre la formation et réduit les pertes de ce tour. À portée courte, revient en couverture tactique.",
        "cost": 1
      },
      {
        "id": "recharge",
        "label": "Répartir l’énergie",
        "detail": "Récupère 4 unités d’énergie. L’exposition accrue rend la prochaine attaque plus dangereuse.",
        "cost": 0
      },
      {
        "id": "brace",
        "label": "Former un écran",
        "detail": "Récupère jusqu’à 2 unités d’énergie et couvre le groupe. En escorte, protège un segment après identification et rapprochement.",
        "cost": 0
      },
      {
        "id": "disrupt",
        "label": "Neutraliser les moteurs",
        "detail": "Endommage la propulsion du contact identifié. À 0, l’adversaire est neutralisé et l’abordage devient possible.",
        "cost": 3
      },
      {
        "id": "fire",
        "label": "Tir concentré",
        "detail": "Frappe le bâtiment identifié. En interception, sa neutralisation complète conclut l’opération.",
        "cost": 3
      },
      {
        "id": "board",
        "label": "Envoyer l’abordage",
        "detail": "À courte portée, engage l’équipe après une analyse complète et une neutralisation suffisante.",
        "cost": 2
      },
      {
        "id": "extract",
        "label": "Extraire l’équipe",
        "detail": "Récupère le transport ou la capsule lorsque son objectif est sécurisé.",
        "cost": 2
      },
      {
        "id": "withdraw",
        "label": "Rompre le contact",
        "detail": "Rappelle la formation. L’opération se termine sans victoire ni récompense.",
        "cost": 0
      }
    ]
  },
